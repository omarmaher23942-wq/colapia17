// wrangler.jsonc — إعداد Colapia على Cloudflare Workers. دليل المالك: docs/deploy-cloudflare.md.
// لا مفاتيح هنا أبداً: الأسرار من لوحة Cloudflare (Settings ← Variables and Secrets) أو `wrangler secret put`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "colapia",
  // يغلّف عامل OpenNext ويضيف المهام المجدولة (cron) بدل Vercel Cron وجداول QStash.
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // esbuild كان يحقن دالة __name داخل الدوال، فتنكسر السكربتات التي يكتبها React/Next نصاً داخل الصفحة
  // (خطأ «__name is not defined» في المتصفح). التعطيل يمنع الحقن.
  "keep_names": false,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // تحسين الصور (next/image) عبر Cloudflare Images.
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true },
  "triggers": {
    // كل 10 دقائق: استعادة المهام المجدولة المتأخرة (ops/sweep). يومياً 04:00 UTC: المتابعة اليومية (ops/tick).
    "crons": ["*/10 * * * *", "0 4 * * *"]
  },
  // colapia.com والمتاجر <slug>.colapia.com. المسار «*/*» (يلتقط نطاقات العملاء أيضاً) يرفضه Cloudflare قبل تفعيل
  // Cloudflare for SaaS على المنطقة (خطأ 10022)، فنكتفي بمسارين صريحين الآن، ويُضاف «*/*» عند تفعيل النطاقات الخاصة
  // (الدليل: docs/deploy-cloudflare.md القسم 8). media.colapia.com (صور R2) يخدمه العامل نفسه من R2 (cloudflare/media.ts).
  "routes": [
    { "pattern": "colapia.com/*", "zone_name": "colapia.com" },
    { "pattern": "*.colapia.com/*", "zone_name": "colapia.com" }
  ],
  // متغيرات وقت التشغيل غير السرية. متغيرات NEXT_PUBLIC_* تُثبَّت في الكود وقت البناء: تُضبط أيضاً في «Build variables»
  // (الدليل، القسم 2).
  "vars": {
    "NEXT_PUBLIC_ROOT_DOMAIN": "colapia.com",
    "ROOT_DOMAIN": "colapia.com",
    "NEXT_PUBLIC_APP_URL": "https://colapia.com",
    // على Workers يكتب Cloudflare هذا الهيدر بعنوان الزائر الحقيقي ولا يقبل نسخة من العميل (lib/client-ip.ts).
    "TRUST_CF_CONNECTING_IP": "1"
  }
}
