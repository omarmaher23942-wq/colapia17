# ─────────────────────────────────────────────────────────────────────────────
# Colapia — متغيرات بيئة المنصة (انسخ الملف إلى .env.local واملأ القيم)
# هذه مفاتيح المنصة: تُستخدم لفترة التجربة (24 ساعة) ولتشغيل المنصة نفسها.
# بعد الدفع، يعمل كل متجر بمفاتيح تاجره الخاصة من خزنة المفاتيح.
# ─────────────────────────────────────────────────────────────────────────────

# ── النطاق والتطبيق ─────────────────────────────────────────────────────────
ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── قاعدة البيانات (Neon — Pooled connection string) ──────────────────────
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ── التخزين والرفع (UploadThing v7) ─────────────────────────────────────────
UPLOADTHING_TOKEN=

# ── الذكاء الاصطناعي (مفاتيح المنصة لفترة التجربة) ───────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MORPHEUS_API_KEY=
MORPHEUS_BASE_URL=https://api.mor.org/api/v1
# Morpheus خارج سلاسل النماذج افتراضياً؛ 1 = يُجرَّب آخراً
AI_USE_MORPHEUS=
CLAUDE_MODEL=claude-sonnet-4.5
CLAUDE_OPUS_MODEL=claude-opus-4.1

# ── Upstash (Redis + QStash + Workflow) ─────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_URL=https://qstash-us-east-1.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# سر داخلي (28+ حرفاً): node -e "console.log(require('crypto').randomBytes(28).toString('base64url'))"
QSTASH_INTERNAL_SECRET=

# ── الوقت الفعلي (Pusher) — اختياري؛ بدونه تُعطَّل الإشعارات الحية ─────────────
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# ── البريد (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Colapia <hello@colapia.com>"

# ── تسجيل الدخول (Google OAuth) ─────────────────────────────────────────────
# Redirect URI المطلوب في Google Cloud: ${NEXT_PUBLIC_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── الأسرار (32+ حرفاً لكل منها): openssl rand -base64 32 ─────────────────────
AUTH_SECRET=
MAGIC_LINK_SECRET=
# مفتاح تشفير خزنة مفاتيح التجار (AES-256-GCM)
ENCRYPTION_KEY=
BOOTSTRAP_OWNER_SECRET=
CRON_SECRET=
# معاينة الفريق للمتاجر قبل التسليم (اختياري، 16+ حرفاً): <slug>.colapia.com/?preview=<المفتاح> يفتح المتجر خلف
# بوابة «قيد التجهيز» لهذا المتصفح، وفي نشرات Preview يصبح شرطاً لـ ?store=<slug>&key=<المفتاح>.
STORE_PREVIEW_KEY=
# خلف Cloudflare فقط: اقرأ عنوان الزائر من cf-connecting-ip (على Vercel اتركه فارغاً، وإلا أمكن تزوير العنوان).
TRUST_CF_CONNECTING_IP=
# استمارة الوكالة: واتساب الوكالة الظاهر للعملاء (01xxxxxxxxx) وعنوان الرد على بريدهم (كلاهما اختياري).
AGENCY_WHATSAPP=
INTAKE_REPLY_TO=
# التجهيز الآلي (اختياري): توكن GitHub دقيق الصلاحية (Contents: Read and write على مستودع المنصة فقط) يكتب
# stores/<slug>/ في فرع build/<slug>-1. بدونه يُنزَّل المجلد ZIP من صفحة الطلب. المستودع بصيغة owner/repo.
STORES_GITHUB_TOKEN=
STORES_GITHUB_REPO=
# النطاقات الخاصة للتجار (اختياري): توكن Vercel ومعرّف المشروع (وفريقه إن وُجد) لإضافة النطاق للمشروع آلياً.
# بدونها يضيف المالك النطاق يدوياً من لوحة Vercel، واللوحة تعرض له القائمة. الدليل: docs/deploy-vercel.md
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ── المالكون (يُفعَّلون تلقائياً كـ owner عند الدخول بـ Google) ─────────────────
PLATFORM_OWNER_EMAILS=owner@example.com
ADMIN_MESSENGER_PSID=

# ── الدفع للمنصة (تحويل يدوي) ───────────────────────────────────────────────
VODAFONE_CASH_NUMBER=01000000000
INSTAPAY_NUMBER=01000000000
# الأسعار تُضبط من لوحة المالك (/admin/pricing) لا من المتغيرات.

# ── دورة الحياة ─────────────────────────────────────────────────────────────
TRIAL_ACTIVE_MINUTES=480
TRIAL_HOURS=24
GRACE_DAYS=7
DELIVERY_SLA_HOURS=1
ONBOARDING_LINK_TTL_DAYS=7
PAYMENT_INVITE_DELAY_MIN=30
DOOM_HOURS=24

# ── Meta (بوت Messenger / Instagram) ───────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ACCESS_TOKEN=
# اختياري: سر تطبيق إنستجرام إن كانت رسائله موقّعة بسر غير META_APP_SECRET
META_INSTAGRAM_APP_SECRET=
META_PAGE_ID=
META_IG_ID=

# ── أُضيفت مع جولات الإطلاق (قيم وهمية؛ التفاصيل في docs/OWNER-GUIDE.md وdocs/deploy-cloudflare.md) ──
# من يصله تنبيه كل إيصال دفع (مفصولة بفواصل؛ الافتراضي بريد المالك)
OWNER_ALERT_EMAILS=owner@example.com
# نموذج قراءة الصور للبحث بالصورة (اختياري)
GROQ_VISION_MODEL=
# صور المتاجر على Cloudflare R2 (بدونها تبقى الصور على UploadThing). الرفع عبر الخادم، والرابط العام media.<النطاق> افتراضياً
MEDIA_BASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
# النطاقات الخاصة للتجار عبر Cloudflare for SaaS (اختياري)
CF_API_TOKEN=
CF_ZONE_ID=
CF_SAAS_TARGET=
# النقل الذاتي القديم إلى GitHub (اختياري)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
