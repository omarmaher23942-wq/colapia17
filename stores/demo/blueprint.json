      "title": "أسئلة شائعة",
      "items": [
        {
          "q": "هل هذا متجر حقيقي؟",
          "a": "هذا متجر عرض من Colapia يوضح شكل المتجر الجاهز وتجربة الشراء كاملة. يمكن إضافة القطع إلى السلة وإتمام الطلب للتجربة، لكن الطلب يُسجَّل تجريبياً فلا يُشحن ولا يُطلب عنه أي مبلغ. بعض صور القطع رسوم توضيحية بدل التصوير."
        },
        {
          "q": "كيف أطلب؟",
          "a": "باختيار المقاس واللون، ثم «إضافة للسلة»، ثم إكمال بيانات الشحن في صفحة إتمام الطلب."
        },
        {
          "q": "كيف أعرف المقاس المناسب؟",
          "a": "في الصفحة الرئيسية أداة «اعرفوا مقاسكم» تقترح المقاس من الطول والوزن، وفي صفحة كل قطعة زر «دليل المقاسات» بجدول القياسات بالسنتيمتر."
        },
        {
          "q": "ما مدة التوصيل؟",
          "a": "من 2 إلى 5 أيام عمل حسب المحافظة، وتظهر المدة المتوقعة لكل محافظة في صفحة إتمام الطلب."
        },
        {
          "q": "هل الدفع عند الاستلام متاح؟",
          "a": "نعم، الدفع نقداً عند استلام الطلب متاح لكل الطلبات."
        },
        {
          "q": "هل يمكن فتح الشحنة قبل الدفع؟",
          "a": "نعم، يمكن فتح الشحنة وفحص القطعة مع المندوب قبل الدفع."
        },
        {
          "q": "ما سياسة الاستبدال والاسترجاع؟",
          "a": "الاستبدال والاسترجاع متاحان خلال 14 يوماً من الاستلام، بشرط أن تكون القطعة بحالتها الأصلية."
        },
        {
          "q": "متى يكون الشحن مجانياً؟",
          "a": "الشحن مجاني لأي طلب قيمته 3,000 ج.م أو أكثر."
        }
      ]
    },
