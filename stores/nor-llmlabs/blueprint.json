        {
          "q": "كم سعر الشحن؟",
          "a": "القاهرة والجيزة 60 جنيهاً، وأسوان والأقصر 120 جنيهاً، وباقي المحافظات 80 جنيهاً. ويظهر السعر النهائي في صفحة الطلب عند اختيار المحافظة."
        },
        {
          "q": "متى يصل الطلب؟",
          "a": "خلال 2 إلى 4 أيام من تأكيد الطلب."
        },
        {
          "q": "هل يمكن فتح الشحنة قبل الدفع؟",
          "a": "نعم. افتحوا الشحنة وعاينوا القطعة مع المندوب، ثم ادفعوا."
        },
        {
          "q": "ما طرق الدفع؟",
          "a": "الدفع نقداً عند الاستلام، أو تحويل مسبق بفودافون كاش مع رفع صورة التحويل في صفحة الطلب."
        },
        {
          "q": "هل يمكن الاستبدال أو الاسترجاع؟",
          "a": "نعم، خلال 7 أيام من الاستلام، والقطعة بحالتها الأصلية غير ملبوسة وبملصقاتها."
        },
        {
          "q": "كيف أختار المقاس؟",
          "a": "في صفحة الجينز جدول مقاسات بجانب اختيار المقاس. ولأي قطعة أخرى راسلونا على واتساب ونساعدكم في الاختيار."
        }
